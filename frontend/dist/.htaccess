Options -Indexes
RewriteEngine On

# No tocar archivos y carpetas reales
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# No redirigir el backend PHP
RewriteCond %{REQUEST_URI} !^/backend/

# Todo lo demas va a index.html (React Router)
RewriteRule ^ index.html [QSA,L]

# index.html nunca se cachea — el browser siempre lo pide fresco
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Assets JS/CSS se cachean por 1 año (Vite usa hashes en el nombre)
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
